# Konfigurasi Port & Secret Key
PORT=5000
JWT_SECRET=emosiku_secret_key_bkpi_2026

# Opsi 1: Cloud Database SUPABASE / NEON (PostgreSQL) - Untuk Hosting di Vercel
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Opsi 2: Database Lokal MySQL (Port 3307) - Untuk Pengujian Lokal
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME=emosiku_db

# Pengiriman Email Kode Lupa Kata Sandi (SMTP)
# Contoh Gmail: aktifkan verifikasi 2 langkah, lalu buat "Sandi Aplikasi" (App Password) 16 karakter
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=emailanda@gmail.com
SMTP_PASS=sandi_aplikasi_16_karakter
MAIL_FROM=EMOSIKU <emailanda@gmail.com>
