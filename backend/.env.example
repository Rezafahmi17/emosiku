# Konfigurasi Port & Secret Key
PORT=5000
JWT_SECRET=emosiku_secret_key_bkpi_2026

# Opsi 1: Cloud Database SUPABASE (PostgreSQL) - Untuk Hosting di Vercel
# Ambil URI koneksi dari Dashboard Supabase: Project Settings -> Database -> Connection Pooling (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Opsi 2: Database Lokal MySQL (Port 3307) - Untuk Pengujian Lokal
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME=emosiku_db
